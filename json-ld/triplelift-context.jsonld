  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://triplelift.com",
      "name": "TripleLift",
      "description": "TripleLift is a programmatic advertising company specializing in native inventory with APIs for managing native ad units, deals, targeting, viewability measurement, and creative quality.",
      "url": "https://triplelift.com",
      "sameAs": [
        "https://github.com/triplelift",
        "https://www.linkedin.com/company/triplelift/",
        "https://twitter.com/TripleLiftHQ"
      ]
    },
    {
      "@type": "WebAPI",
      "@id": "https://tlx.3lift.com",
      "name": "TripleLift Exchange (TLX) API",
      "description": "Real-time bidding API implementing OpenRTB 2.x and Native Ads 1.2 specifications for demand partners to participate in native, banner, and video ad auctions.",
      "documentation": "https://docs.triplelift.com",
      "provider": {
        "@id": "https://triplelift.com"
      }
    },
    {
      "@type": "WebAPI",
      "@id": "https://supply-docs.triplelift.com",
      "name": "TripleLift Supply Publisher API",
      "description": "REST API for supply partners and publishers to access network reporting, connected TV publisher network reports, and integration management.",
      "documentation": "https://supply-docs.triplelift.com/reference/introduction",
      "provider": {
        "@id": "https://triplelift.com"
      }
    }
  ]
}
